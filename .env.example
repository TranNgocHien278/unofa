# Copy to .env (chmod 0600). Docker Compose reads this file only to fill ${...} in docker-compose.yml;
# a container sees a value only when its service lists it under `environment:`.

# Postgres password, used by db, migrate and app (inside DATABASE_URL).
POSTGRES_PASSWORD=change-me

# true serves admin.tnhien.tech through nginx; false removes that site from nginx.
UNOFA_ADMIN=true
