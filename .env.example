# Copy to .env (chmod 0600).

# Postgres password, used by db, migrate and app (inside DATABASE_URL).
POSTGRES_PASSWORD=change-me

# Image tag for ghcr.io/unofa/unofa and ghcr.io/unofa/unofa-nginx.
UNOFA_TAG=latest

# true serves admin.example.com through nginx; false removes that site from nginx.
UNOFA_ADMIN=true
